    <tr><td style="padding:3px; border-bottom:1px solid #ddd;"><b>Distance to Node:</b></td><td style="padding:3px; border-bottom:1px solid #ddd;">0.11 km</td></tr>
    <tr><td style="padding:3px; border-bottom:1px solid #ddd;"><b>Backhaul Tier:</b></td><td style="padding:3px; border-bottom:1px solid #ddd;">Tier 1A (Direct Coloc, <1 km)</td></tr>
